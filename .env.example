# PrioritySuite Environment Configuration
DJANGO_SECRET_KEY=change-this-to-a-secure-random-key-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Database
# Default: SQLite for local dev
DATABASE_ENGINE=sqlite
# For MariaDB / MySQL in production:
# DATABASE_ENGINE=mysql
# DB_NAME=prioritysuite
# DB_USER=prioritysuite
# DB_PASSWORD=your_secure_password
# DB_HOST=db
# DB_PORT=3306

# Encryption key for BYOK API keys (Fernet 32 url-safe base64-encoded bytes)
# If empty, a key will be derived from DJANGO_SECRET_KEY
ENCRYPTION_KEY=

# Optional default LLM settings
OLLAMA_API_BASE=http://localhost:11434
OPENROUTER_API_BASE=https://openrouter.ai/api/v1
