# PrioritySuite Environment Configuration (Managed by Ansible)
DJANGO_SECRET_KEY={{ django_secret_key }}
DEBUG=False
ALLOWED_HOSTS={{ allowed_hosts }}

# Database Configuration
DATABASE_ENGINE=mysql
DB_NAME={{ db_name }}
DB_USER={{ db_user }}
DB_PASSWORD={{ db_password }}
DB_HOST={{ db_host }}
DB_PORT={{ db_port }}

# BYOK Sensitive Data Encryption Key
ENCRYPTION_KEY={{ encryption_key }}

# LLM Internal Host Allowlist
OLLAMA_ALLOWED_HOSTS={{ ollama_allowed_hosts }}

# Ensure LiteLLM uses bundled cost map in offline/restricted network environments
LITELLM_LOCAL_MODEL_COST_MAP=True
