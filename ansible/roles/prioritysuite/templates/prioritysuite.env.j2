# PrioritySuite Environment Configuration (Managed by Ansible)
DJANGO_SECRET_KEY="{{ django_secret_key | replace('\\', '\\\\') | replace('\"', '\\\"') }}"
DEBUG=False
ALLOWED_HOSTS="{{ allowed_hosts }}"

# Cookie security settings matched to SSL enablement
SESSION_COOKIE_SECURE={{ enable_ssl | ternary('True', 'False') }}
CSRF_COOKIE_SECURE={{ enable_ssl | ternary('True', 'False') }}

# Database Configuration
DATABASE_ENGINE=mysql
DB_NAME="{{ db_name | replace('\\', '\\\\') | replace('\"', '\\\"') }}"
DB_USER="{{ db_user | replace('\\', '\\\\') | replace('\"', '\\\"') }}"
DB_PASSWORD="{{ db_password | replace('\\', '\\\\') | replace('\"', '\\\"') }}"
DB_HOST="{{ db_host | replace('\\', '\\\\') | replace('\"', '\\\"') }}"
DB_PORT={{ db_port }}

# BYOK Sensitive Data Encryption Key
ENCRYPTION_KEY="{{ encryption_key | replace('\\', '\\\\') | replace('\"', '\\\"') }}"

# LLM Internal Host Allowlist
OLLAMA_ALLOWED_HOSTS="{{ ollama_allowed_hosts | replace('\\', '\\\\') | replace('\"', '\\\"') }}"

# Ensure LiteLLM uses bundled cost map in offline/restricted network environments
LITELLM_LOCAL_MODEL_COST_MAP=True
