[Unit]
Description=PrioritySuite Gunicorn Application Daemon
After=network.target mariadb.service

[Service]
User={{ app_user }}
Group={{ app_group }}
WorkingDirectory={{ app_root }}
EnvironmentFile={{ app_root }}/.env
ExecStart={{ app_root }}/.venv/bin/gunicorn \
          --workers {{ gunicorn_workers }} \
          --timeout {{ gunicorn_timeout | default(90) }} \
          --bind {{ gunicorn_bind }} \
          --access-logfile - \
          --error-logfile - \
          config.wsgi:application
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
